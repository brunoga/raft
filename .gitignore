# Binaries.
#
# `go build ./examples/ledger/` from the repository root leaves the binary
# here, named after the package directory, not in the example's own folder --
# which is how a 22MB `ledger` nearly landed in a commit. Every example is
# listed, so building any of them from the root is safe.
/configsvc
/durablekv
/idprovider
/ledger
/raftctl
/ratelimiter
/serviceregistry
/shardkv
/tenants
/watchtower
# Example binaries, built in place by each cluster.sh.
/examples/*/configsvc
/examples/*/durablekv
/examples/*/idprovider
/examples/*/ledger
/examples/*/raftctl
/examples/*/ratelimiter
/examples/*/serviceregistry
/examples/*/agent-bin
/examples/*/shardkv
/examples/*/watchtower
/cmd/kvd/kvd
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage
*.test
*.out
/test_output.txt
coverage.html
coverage.out

# Build cache / vendor
/vendor/

# Go workspace files
go.work
go.work.sum

# OS
.DS_Store
Thumbs.db

